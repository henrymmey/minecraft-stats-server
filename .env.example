APP_NAME="HM Stats Server"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hm_stats
DB_USERNAME=hm_stats
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
# auto uses the provider's advertised order and falls back between
# client_secret_post, client_secret_basic, and none on invalid_client.
# Set explicitly to client_secret_basic, client_secret_post, or none when required.
OIDC_TOKEN_ENDPOINT_AUTH_METHOD=auto
OIDC_REQUIRE_HTTPS=false

API_KEY_PEPPER=
